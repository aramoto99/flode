# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# pytest / coverage / type / lint cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# venv
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Notebook checkpoints (自動生成物) を無視
.ipynb_checkpoints/

# Generated artifacts (regenerate via examples/*.py)
spring_mass_damper.png
pid_bode.png

# Local model storage for `flode --model-dir ./models` (= ユーザーデータ、
# repo に含めない)
models/

# Sphinx build output (regenerate via `sphinx-build -b html docs docs/_build`)
docs/_build/
docs/_autosummary/

# Frontend (ADR-0012)
node_modules/
flode/web/frontend/dist/
flode/web/frontend/.vite/
flode/web/frontend/tsconfig.tsbuildinfo
# StaticFiles 配信先: ローカル build 時のみ生成、release 時は別管理 (ADR-0012 §(8))
flode/server/static/

# Frontend logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright (E2E テスト出力)。`playwright.config.ts` の `cwd` 解決方法によっては
# repo root にも書き込まれるので両方無視する。
test-results/
playwright-report/
flode/web/frontend/test-results/
flode/web/frontend/playwright-report/
flode/web/frontend/playwright/.cache/
# E2E backend の workspace (fixtures の使い捨てコピー、global-setup.ts が生成)
flode/web/frontend/tests/e2e/.workspace/

# Claude Code config / docs — local-only, not tracked (public 化しても非公開)
.claude/

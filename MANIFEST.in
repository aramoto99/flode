include README.md
include LICENSE
include CHANGELOG.md
recursive-include flode/server/static *

# sdist から frontend source / build artifacts を除外 (release CI が build した
# artifacts は package_data 経由で wheel に同梱、source 配布物には不要)
prune flode/web/frontend/node_modules
prune flode/web/frontend/dist
prune flode/web/frontend/.vite
exclude flode/web/frontend/tsconfig.tsbuildinfo
